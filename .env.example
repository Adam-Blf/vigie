# Copy to .env and adjust. Never commit the real .env.
# Every variable maps to a field of src/vigie/config.py (prefix VIGIE_).

# LLM: ollama (default, local), fake (tests and load tests), mistral (paid, off by default)
VIGIE_LLM_PROVIDER=ollama
VIGIE_OLLAMA_URL=http://127.0.0.1:11434
VIGIE_OLLAMA_MODEL=ministral-3:3b-instruct-2512-q4_K_M
VIGIE_LLM_NUM_CTX=4096
VIGIE_LLM_NUM_PREDICT=400
VIGIE_LLM_TEMPERATURE=0.1
VIGIE_LLM_TIMEOUT_S=120.0
# Only if a paid Mistral key is ever added
VIGIE_MISTRAL_API_KEY=
VIGIE_MISTRAL_MODEL=ministral-3b-latest
VIGIE_MISTRAL_URL=https://api.mistral.ai
# Fake LLM only: 1 makes it invent a citation, to prove the validator removes it
FAKE_LLM_HALLUCINATE=0

# RAG: passages below this score are noise; without a valid citation the answer is a refusal
VIGIE_RAG_MIN_SCORE=0.0
VIGIE_RAG_REQUIRE_CITATION=true

# Vector store: either a Qdrant server URL or a local path
VIGIE_QDRANT_URL=http://127.0.0.1:6733
VIGIE_QDRANT_API_KEY=

# API
VIGIE_HOST=127.0.0.1
VIGIE_PORT=8710
VIGIE_AUDIT_RETENTION_DAYS=30
VIGIE_RATE_LIMIT_PER_MINUTE=20

# Production input guard: regex, then the ONNX int8 classifier on English text.
# onnx needs the files of python -m vigie.guard.prepare; off keeps the regex alone.
VIGIE_GUARD_CLASSIFIER=onnx
VIGIE_GUARD_INPUT_THRESHOLD=0.5
VIGIE_GUARD_MODEL_DIR=models/guard
VIGIE_GUARD_MODEL_REPO=protectai/deberta-v3-base-prompt-injection-v2
VIGIE_GUARD_MODEL_REVISION=90c9989b1a342275dd0d1a95aad283c04e075671
VIGIE_GUARD_MAX_TOKENS=512
VIGIE_GUARD_THREADS=2

# Guardrail benchmark (guardbench), see docs/guardrails-benchmark.md
# Optional, Lakera is skipped without it
LAKERA_API_KEY=
VIGIE_LAKERA_URL=https://api.lakera.ai/v2/guard
VIGIE_BENCH_SEED_PATH=data/seed.jsonl
VIGIE_BENCH_OUTPUT_DIR=results/guardbench
VIGIE_BENCH_WARMUP_CALLS=3
VIGIE_BENCH_HTTP_TIMEOUT_S=30.0
# Two threads, like the 2 OCPU Oracle VM
VIGIE_BENCH_TORCH_THREADS=2
VIGIE_BENCH_DEEPSET_REPO=deepset/prompt-injections
VIGIE_BENCH_DEBERTA_MODEL=protectai/deberta-v3-base-prompt-injection-v2
VIGIE_BENCH_GLIGUARD_MODEL=fastino/gliguard-LLMGuardrails-300M
VIGIE_BENCH_LLAMAGUARD_MODEL=llama-guard3:1b
VIGIE_BENCH_PRESIDIO_ENTITIES=["EMAIL_ADDRESS","IBAN_CODE","CREDIT_CARD","PHONE_NUMBER"]
VIGIE_BENCH_PRESIDIO_THRESHOLD=0.5
VIGIE_MLFLOW_TRACKING_URI=sqlite:///mlflow.db
VIGIE_BENCH_MLFLOW_EXPERIMENT=guardbench

# Corpus ingestion (vigie-ingest), HTTPS only, see docs/corpus.md
VIGIE_CELLAR_BASE_URL=https://publications.europa.eu/resource/celex/
VIGIE_CELLAR_ALLOWED_HOST=publications.europa.eu
VIGIE_EURLEX_BASE_URL=https://eur-lex.europa.eu/legal-content/FR/TXT/?uri=CELEX:
VIGIE_CORPUS_LANGUAGE=fra
VIGIE_CORPUS_CACHE_DIR=data/cache
VIGIE_CORPUS_LOCK_PATH=data/corpus.lock
# At least one second between two requests to Cellar
VIGIE_CORPUS_MIN_INTERVAL_S=1.0
VIGIE_CORPUS_MAX_RETRIES=4
VIGIE_CORPUS_BACKOFF_S=2.0
VIGIE_CORPUS_TIMEOUT_S=60.0
VIGIE_CORPUS_MAX_REDIRECTS=5
# Articles longer than this many words are split
VIGIE_CORPUS_SPLIT_WORDS=1200

# Drift detection (vigie-drift), see docs/drift.md
VIGIE_DRIFT_REFERENCE_PATH=data/drift/reference.npy
VIGIE_DRIFT_ANCHORS_PATH=data/drift/anchors.npy
VIGIE_DRIFT_WINDOW_SIZE=500
# No alert before this many questions in the window
VIGIE_DRIFT_MIN_WINDOW=30
VIGIE_DRIFT_EVALUATE_EVERY=10
VIGIE_DRIFT_CENTROID_THRESHOLD=0.3
VIGIE_DRIFT_OUT_OF_SCOPE_SIMILARITY=0.3
VIGIE_DRIFT_OUT_OF_SCOPE_RATIO=0.25
VIGIE_DRIFT_KS_ALPHA=0.01

# Load test (python tasks.py load-local), see docs/load-test.md
# Test token for the local API, never a real user token
VIGIE_LOAD_TOKEN=
# Must stay equal to the load section of eval/thresholds.yaml
VIGIE_LOAD_P95_MS=500
VIGIE_LOAD_MAX_ERROR_RATIO=0.01
VIGIE_LOAD_MAX_ATTACK_LEAK_RATIO=0.10

# Golden set (vigie-eval), see data/golden/README.md
VIGIE_GOLDEN_PATH=data/golden/questions.jsonl
VIGIE_GOLDEN_SEAL_PATH=data/golden/test.sha256
