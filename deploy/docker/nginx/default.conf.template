# The interface and the API under one origin: / is the PWA, /v1 goes to the API, so the
# browser never needs CORS (brief 11.10). ${VIGIE_API_UPSTREAM} is filled in by the image
# entrypoint (envsubst) when the container starts; nginx's own $variables are left alone.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    # Same ceiling as the API (VIGIE_MAX_BODY_BYTES): a larger body is refused here already.
    client_max_body_size 16k;

    include /etc/nginx/snippets/security-headers.conf;

    location /v1/ {
        proxy_pass http://${VIGIE_API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_set_header X-Forwarded-Proto $scheme;
        # /v1/ask/stream sends server-sent events: each delta must leave at once.
        proxy_buffering off;
        proxy_read_timeout 180s;
    }

    # Read at every start of the app, so a new API base URL needs no rebuild.
    location = /config.json {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-store" always;
    }

    # The service worker and the shell must be revalidated or an update never shows.
    location ~ ^/(sw\.js|index\.html|manifest\.webmanifest)$ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
    }

    # Vite puts a content hash in every file name under /assets.
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
