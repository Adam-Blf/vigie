# Pinned versions of everything the deployment pulls from outside the repository.
# The manifests carry the same values (kustomize cannot read this file); a test checks
# that the two never drift apart. Digests are multi-architecture index digests, valid
# for amd64 (local k3d) and arm64 (Oracle Ampere).

# Cluster
K3S_VERSION=v1.35.5+k3s1
K3S_IMAGE=docker.io/rancher/k3s:v1.35.5-k3s1@sha256:2074403abe1bded11ef3dde09d457e13be8e0b64c218b1c4f8269b4565cfbc65
TRAEFIK_CHART=39.0.7
TRAEFIK_VERSION=3.6.13

# Add-ons
ARGO_ROLLOUTS_VERSION=v1.10.0
ARGO_ROLLOUTS_IMAGE=quay.io/argoproj/argo-rollouts:v1.10.0@sha256:187630ba722846bb8e079630364d3c29c8246a256be95785fd957b088f621c4e
FLUX_VERSION=v2.9.6

# Application dependencies
QDRANT_IMAGE=docker.io/qdrant/qdrant:v1.19.1-unprivileged@sha256:801777072776dc81b2a9dd2007b2ed487571f21ecd30efffd15ddb1671f2193d
MLFLOW_IMAGE=ghcr.io/mlflow/mlflow:v3.16.1@sha256:06058cc872276873e9759c635e773342aca4731e240f6d20d88ea43774083984
PROMETHEUS_IMAGE=quay.io/prometheus/prometheus:v3.15.0@sha256:efd719c99d83b060d9daefdcf00360461adf279f45ef5391f8d111892118753e
OLLAMA_IMAGE=docker.io/ollama/ollama:0.35.0@sha256:2a6e883b917fc543389599dae79918f5cac9e1438890506982f44aa4f5625d01
CURL_IMAGE=docker.io/curlimages/curl:8.16.0@sha256:463eaf6072688fe96ac64fa623fe73e1dbe25d8ad6c34404a669ad3ce1f104b6

# Validation tools (downloaded to a temporary folder, never into the repository)
KUSTOMIZE_VERSION=v5.8.2
KUBECONFORM_VERSION=v0.8.0
K3D_VERSION=v5.9.0
CRDS_CATALOG_COMMIT=d373c2da9702bc9509a004db83e57263fe3bdfc1
