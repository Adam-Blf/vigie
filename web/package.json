{
  "name": "vigie-web",
  "private": true,
  "version": "0.1.0",
  "description": "Vigie progressive web app: cited answers on DORA, the AI Act, GDPR and AMLR.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "npm run typecheck && vite build && node scripts/check-bundle.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "lhci": "lhci autorun",
    "contrast": "node scripts/check-contrast.ts",
    "assets": "node scripts/build-icons.ts && node scripts/export-mascot.ts && node scripts/export-icons.ts",
    "check-rive": "node scripts/check-rive.ts",
    "capture": "node scripts/capture-proofs.ts"
  },
  "dependencies": {
    "@phosphor-icons/web": "^2.1.2",
    "@rive-app/canvas": "^2.44.0",
    "preact": "^11.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "jsdom": "^30.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3",
    "workbox-window": "^7.4.1"
  },
  "overrides": {
    "basic-ftp": "^6.2.2",
    "tmp": "^0.2.7",
    "uuid": "^11.1.1"
  }
}
